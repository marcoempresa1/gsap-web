---
import BaseButton from "@/shared/BaseButton.astro";
import { Image } from 'astro:assets';
import logoUrl from "@/assets/image/dblogo.webp";
---

<header
  id="header"
  header-animation-top
  class="absolute top-0 left-0 w-full z-50 px-6 py-4 flex items-center justify-center pointer-events-none"
>
  <nav
    class="pointer-events-auto px-8 py-2.5 rounded-full bg-black/45 backdrop-blur-md border border-white/10 flex items-center gap-6 sm:gap-8 text-sm sm:text-base font-normal tracking-widest text-white/90 uppercase shadow-lg font-['Bebas_Neue']"
  >
    <a
      href="#inicio"
      class="hover:text-amber-300 transition-colors duration-200">INICIO</a
    >
    <a href="#el-poder" class="hover:text-amber-400 transition-colors duration-200"
      >EL PODER</a
    >
    <a
      href="#mundo"
      class="hover:text-amber-300 transition-colors duration-200">MUNDO</a
    >
    <a
      href="#web-oficial"
      class="hover:text-amber-300 transition-colors duration-200">WEB OFICIAL</a
    >
  </nav>
</header>
