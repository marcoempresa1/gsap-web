---
import BaseButton from "@/shared/BaseButton.astro";
const logoUrl = "/image/dblogo.webp";
---

<header
  id="header"
  header-animation-top
  class="absolute top-0 left-0 w-full z-50 px-6 py-4 flex items-center justify-center pointer-events-none"
>
  <nav class="pointer-events-auto px-8 py-2.5 rounded-full bg-black/45 backdrop-blur-md border border-white/10 flex items-center gap-6 sm:gap-8 text-sm sm:text-base font-normal tracking-widest text-white/90 uppercase shadow-lg font-['Bebas_Neue']">
    <a href="#personajes" class="hover:text-cyan-400 transition-colors duration-200">PERSONAJES</a>
    <a href="#mundo" class="hover:text-cyan-400 transition-colors duration-200">MUNDO</a>
    <a href="#noticias" class="hover:text-cyan-400 transition-colors duration-200">NOTICIAS</a>
    <a href="#tienda" class="hover:text-cyan-400 transition-colors duration-200">TIENDA</a>
  </nav>
</header>
