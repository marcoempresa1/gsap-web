---
import { Image } from "astro:assets";
import logoUrl from "@/assets/image/dblogo.webp";
---

<footer
  class="bg-black text-neutral-400 border-t border-neutral-900 pt-16 pb-12"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div
      class="grid grid-cols-1 md:grid-cols-4 gap-10 pb-12 border-b border-neutral-900"
    >
      <div class="md:col-span-2 space-y-4">
        <a href="#" class="inline-block">
          <Image
            src={logoUrl}
            alt="Dragon Ball Logo"
            class="h-12 w-auto object-contain filter drop-shadow-[0_0_8px_rgba(245,158,11,0.4)]"
          />
        </a>
        <p class="text-sm text-neutral-500 max-w-sm leading-relaxed">
          Pagina Hecha por Marco Villanueva.
        </p>
        <p class="text-sm text-neutral-500 max-w-sm leading-relaxed">
          Este sitio es un proyecto personal creado con fines educativos y de
          portfolio.
        </p>
        <a
          href="https://www.linkedin.com/in/marco-villanueva-ramirez-2b8631381"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block mt-2 text-sm max-w-sm leading-relaxed bg-blue-600 hover:bg-blue-700 transition-colors text-white py-2 px-4 rounded pointer-events-auto"
        >
          Mi LinkedIn
        </a>
      </div>

      <div>
        <h4 class="text-xs font-bold uppercase tracking-widest text-white mb-4">
          Navegación
        </h4>
        <ul class="space-y-2.5 text-sm">
          <li>
            <a
              href="#inicio"
              class="hover:text-amber-400 transition-colors">Inicio</a
            >
          </li>
          <li>
            <a
              href="#el-poder"
              class="hover:text-amber-400 transition-colors">El Poder</a
            >
          </li>
          <li>
            <a
              href="#mundo"
              class="hover:text-amber-400 transition-colors"
              >Mundo y Características</a
            >
          </li>
          <li>
            <a
              href="#web-oficial"
              class="hover:text-amber-400 transition-colors">Web Oficial</a
            >
          </li>
        </ul>
      </div>
    </div>
  </div>
</footer>
