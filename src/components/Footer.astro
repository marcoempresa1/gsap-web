---
const logoUrl = '/image/dblogo.webp';
---

<footer class="bg-black text-neutral-400 border-t border-neutral-900 pt-16 pb-12">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-10 pb-12 border-b border-neutral-900">
      
      {/* Brand & Info */}
      <div class="md:col-span-2 space-y-4">
        <a href="#" class="inline-block">
          <img src={logoUrl} alt="Dragon Ball Logo" class="h-12 w-auto object-contain filter drop-shadow-[0_0_8px_rgba(245,158,11,0.4)]" />
        </a>
        <p class="text-sm text-neutral-500 max-w-sm leading-relaxed">
          Página promocional oficial desarrollada para fans de Dragon Ball. Experimenta la evolución de los combates anime en 3D.
        </p>
      </div>

      {/* Navigation Links */}
      <div>
        <h4 class="text-xs font-bold uppercase tracking-widest text-white mb-4">Navegación</h4>
        <ul class="space-y-2.5 text-sm">
          <li><a href="#hero" class="hover:text-amber-400 transition-colors">Inicio</a></li>
          <li><a href="#caracteristicas" class="hover:text-amber-400 transition-colors">Características</a></li>
          <li><a href="#lanzamiento" class="hover:text-amber-400 transition-colors">Detalles del Lanzamiento</a></li>
          <li><a href="#ediciones" class="hover:text-amber-400 transition-colors">Ediciones y Pre-orden</a></li>
        </ul>
      </div>

      {/* Socials & Legal */}
      <div>
        <h4 class="text-xs font-bold uppercase tracking-widest text-white mb-4">Comunidad</h4>
        <div class="flex items-center gap-4 mb-4">
          <a href="#" class="p-2.5 rounded-lg bg-neutral-900 hover:bg-neutral-800 hover:text-amber-400 transition-colors" aria-label="X/Twitter">
            <svg class="w-4 h-4 fill-currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          </a>
          <a href="#" class="p-2.5 rounded-lg bg-neutral-900 hover:bg-neutral-800 hover:text-amber-400 transition-colors" aria-label="YouTube">
            <svg class="w-4 h-4 fill-currentColor" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
          </a>
          <a href="#" class="p-2.5 rounded-lg bg-neutral-900 hover:bg-neutral-800 hover:text-amber-400 transition-colors" aria-label="Discord">
            <svg class="w-4 h-4 fill-currentColor" viewBox="0 0 24 24"><path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.061 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.028zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/></svg>
          </a>
        </div>
        <p class="text-xs text-neutral-600">Sigue las noticias oficiales del juego.</p>
      </div>

    </div>

    {/* Copyright Disclaimer */}
    <div class="pt-8 flex flex-col md:flex-row items-center justify-between gap-4 text-xs text-neutral-600">
      <p>© BIRD STUDIO/SHUEISHA, TOEI ANIMATION. © Bandai Namco Entertainment Inc.</p>
      <p class="text-center md:text-right">Diseñado con Astro + GSAP | Landing Minimalista</p>
    </div>
  </div>
</footer>
