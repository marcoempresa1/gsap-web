---
const galleryItems = [
  {
    title: "Enfrentamientos Épicos",
    category: "Combate 3D",
    image: "/image/gallery1.jpg",
    description: "Batallas dinámicas a alta velocidad con escenarios destructibles en tiempo real."
  },
  {
    title: "Transformaciones Legendarias",
    category: "Personajes",
    image: "/image/gallery2.webp",
    description: "Desata todo el poder Saiyajin con animaciones cinematográficas de última generación."
  },
  {
    title: "Gráficos de Nueva Generación",
    category: "Unreal Engine 5",
    image: "/image/gallery3.png",
    description: "Modelos hyper detallados y efectos de energía deslumbrantes que transmiten la verdadera fuerza."
  }
];
---

<section id="gallery-scroll" class="relative h-[300vh] w-full bg-black isolate border-t border-zinc-900">
  <div class="sticky top-0 h-screen w-full overflow-hidden flex items-center">
    <!-- Glow background highlights -->
    <div class="pointer-events-none absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-amber-500/10 blur-[150px] rounded-full"></div>
    <div class="pointer-events-none absolute bottom-10 left-1/4 w-[400px] h-[400px] bg-cyan-500/10 blur-[140px] rounded-full"></div>

    <div class="relative w-full h-full flex flex-col justify-center">
      <!-- Header -->
      <div class="px-10 mb-12 flex-shrink-0 w-full md:w-1/3">
        <span class="inline-block px-4 py-1.5 rounded-full border border-cyan-500/30 bg-cyan-500/10 text-cyan-400 font-semibold tracking-widest text-xs uppercase backdrop-blur-md mb-4">
          Capturas del Juego
        </span>
        <h2 class="text-4xl sm:text-6xl md:text-7xl font-black uppercase tracking-tight text-white font-['Helvetica_Condensed']">
          Galería <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-400 via-orange-500 to-amber-600">Visual</span>
        </h2>
        <p class="mt-4 text-zinc-400 text-base sm:text-lg">
          Echa un vistazo a la fidelidad visual y a los momentos más impactantes directamente extraídos del motor del juego.
        </p>
      </div>

      <!-- Horizontal Scroll Container -->
      <div data-gallery-container class="flex gap-8 px-10 pb-10 w-[300vw] sm:w-[200vw] md:w-[150vw] items-center">
        {galleryItems.map((item) => (
          <div class="gallery-card relative flex-shrink-0 w-[85vw] sm:w-[60vw] md:w-[45vw] h-[50vh] sm:h-[60vh] flex flex-col overflow-hidden rounded-2xl border border-zinc-800/80 bg-zinc-950/60 backdrop-blur-xl transition-colors duration-500 hover:border-amber-500/50">
            <!-- Image container -->
            <div class="relative h-full w-full overflow-hidden">
              <img
                src={item.image}
                alt={item.title}
                class="h-full w-full object-cover transition-transform duration-700 ease-out hover:scale-110"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-zinc-950 via-zinc-950/40 to-transparent"></div>
              <span class="absolute top-6 left-6 px-4 py-1.5 text-xs font-bold uppercase tracking-wider bg-black/70 backdrop-blur-md border border-white/10 text-amber-400 rounded-full">
                {item.category}
              </span>
            </div>

            <!-- Card Content Overlay -->
            <div class="absolute bottom-0 left-0 w-full p-8 flex flex-col justify-end">
              <div class="space-y-3">
                <h3 class="text-2xl sm:text-4xl font-bold text-white drop-shadow-md">
                  {item.title}
                </h3>
                <p class="text-sm sm:text-base text-zinc-300 leading-relaxed max-w-xl drop-shadow-md">
                  {item.description}
                </p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
