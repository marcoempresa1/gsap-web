---
interface Props {
  title?: string;
  subtitle?: string;
  highlightText?: string;
  bgImage?: string;
  personaje?: string;
}

const {
  title = "UN PODER SIN PRECEDENTES",
  subtitle = "Siente el poder de cada batalla en tus manos con efectos visuales deslumbrantes y físicas dinámicas.",
  highlightText = "ROMPE TUS LÍMITES",
  bgImage = "/image/backgroundcorporacion.png",
  personaje = "/image/personaje.png",
} = Astro.props;
---

<section
  id="huge-text-section"
  class="relative h-[550vh] w-full bg-black isolate"
>
  <div
    class="sticky top-0 h-screen w-full flex items-center justify-center overflow-hidden"
  >
    <!-- Background Image -->

    <div
      id="fullscreen-bg-section"
      class="absolute inset-0 flex items-center justify-center overflow-hidden"
    >
      <img src={bgImage} alt="Background" class="w-full h-full object-cover" />
      <!-- Capa de sombra para oscurecer el fondo y que no resalte tanto -->
      <div class="absolute inset-0 bg-black/40"></div>
    </div>

    <div
      id="fullscreen-personaje-section"
      class="absolute inset-0 z-50 pointer-events-none flex items-end justify-center"
    >
      <img
        src={personaje}
        alt="Personaje"
        class="w-full h-full object-contain object-bottom drop-shadow-[0_0_30px_rgba(0,0,0,0.8)]"
      />
    </div>

    <!-- Massive Text Container -->
    <div
      class="relative z-10 w-full h-full flex items-center overflow-hidden whitespace-nowrap"
    >
      <h2
        data-massive-text
        class="text-[15rem] text-white sm:text-[20rem] md:text-[10rem] font-black uppercase tracking-tight text-transparent leading-none font-['Helvetica_Condensed'] select-none"
      >
        {title}
      </h2>
    </div>
  </div>
</section>
