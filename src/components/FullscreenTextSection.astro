---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import bgImageUrl from '@/assets/image/backgroundcorporacion.png';
import personajeUrl from '@/assets/image/personaje.png';

interface Props {
  title?: string;
  subtitle?: string;
  highlightText?: string;
  bgImage?: string | ImageMetadata;
  personaje?: string | ImageMetadata;
}

const {
  title = "UN PODER SIN PRECEDENTES",
  subtitle = "Siente el poder de cada batalla en tus manos con efectos visuales deslumbrantes y físicas dinámicas.",
  highlightText = "ROMPE TUS LÍMITES",
  bgImage = bgImageUrl,
  personaje = personajeUrl,
} = Astro.props;
---

<section
  id="el-poder"
  class="relative h-[400vh] md:h-[500vh] w-full bg-black isolate"
>
  <div
    class="sticky top-0 h-screen w-full flex items-center justify-center overflow-hidden"
  >


    <div
      id="fullscreen-bg-section"
      class="absolute inset-0 flex items-center justify-center overflow-hidden will-change-transform"
    >
      <Image src={bgImage} alt="Background" class="w-full h-full object-cover" />

      <div class="absolute inset-0 bg-black/40"></div>
    </div>

    <div
      id="fullscreen-personaje-section"
      class="absolute inset-0 z-50 pointer-events-none flex items-end justify-center will-change-transform"
    >
      <Image
        src={personaje}
        alt="Personaje"
        class="h-[65vh] w-auto max-w-none md:w-full md:h-full md:max-w-full object-contain object-bottom drop-shadow-[0_0_30px_rgba(0,0,0,0.8)]"
      />

      <div
        class="absolute bottom-0 left-0 w-full h-32 bg-gradient-to-t from-black to-transparent"
      >
      </div>
    </div>


    <div
      class="relative z-10 w-full h-full flex items-center overflow-hidden whitespace-nowrap"
    >
      <h2
        data-massive-text
        class="text-[5.5rem] sm:text-[8rem] md:text-[12rem] lg:text-[15rem] xl:text-[20rem] text-white font-black uppercase tracking-tight text-transparent leading-none font-['Helvetica_Condensed'] select-none will-change-transform"
      >
        {title}
      </h2>
    </div>
  </div>
</section>
